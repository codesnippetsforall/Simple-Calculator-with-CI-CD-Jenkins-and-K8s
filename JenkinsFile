pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RUN_LOCAL_CONTAINER',
            defaultValue: true,
            description: 'Also run a local docker container on port 7070 (manual docker run step)'
        )
        string(
            name: 'DOCKERHUB_CREDENTIALS_ID',
            defaultValue: 'DOCKERHUB_CREDENTIALS_ID',
            description: 'Jenkins Username/Password credentials ID for Docker Hub (docker login + push)'
        )
        string(
            name: 'PUBLIC_HOST_IP_OVERRIDE',
            defaultValue: '',
            description: 'Optional: force public IP for browser URL. Leave empty to auto-detect from EC2 / network.'
        )
    }

    environment {
        // Local build tag (manual: docker build -t simplecasioimg:1.0 .)
        LOCAL_IMAGE    = 'simplecasioimg:1.2'
        // Must match simplecasio_deployment.yaml image:
        DEPLOY_IMAGE   = 'dockermano1984/simplecasioimg:1.2'
        CONTAINER_NAME = 'simplecasiocntr'
        HOST_PORT      = '7070'
        K8S_DEPLOY     = 'simplecasio-deployment'
        K8S_SERVICE    = 'simplecasiopod-service'
        K8S_MANIFEST   = 'simplecasio_deployment.yaml'
        MINIKUBE_K8S_VERSION = 'v1.32.0'
        MINIKUBE_CPUS  = '1'
        MINIKUBE_MEMORY = '2000'
        // Stable public URL port (matches Service nodePort)
        BROWSER_PORT   = '30060'
        // Filled in "Detect Public IP" stage (not hardcoded)
        PUBLIC_HOST_IP = ''
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                // Uses SCM configured on the Jenkins job (Pipeline script from SCM)
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Detect Public IP') {
            steps {
                script {
                    if (params.PUBLIC_HOST_IP_OVERRIDE?.trim()) {
                        env.PUBLIC_HOST_IP = params.PUBLIC_HOST_IP_OVERRIDE.trim()
                        echo "Using PUBLIC_HOST_IP override: ${env.PUBLIC_HOST_IP}"
                    } else {
                        env.PUBLIC_HOST_IP = sh(
                            script: '''
                                set +e
                                IP=""

                                # 1) EC2 Instance Metadata Service (IMDSv2, then IMDSv1)
                                TOKEN=$(curl -sf --max-time 2 -X PUT "http://169.254.169.254/latest/api/token" \
                                    -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" 2>/dev/null)
                                if [ -n "$TOKEN" ]; then
                                    IP=$(curl -sf --max-time 2 -H "X-aws-ec2-metadata-token: $TOKEN" \
                                        http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)
                                fi
                                if [ -z "$IP" ]; then
                                    IP=$(curl -sf --max-time 2 http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null)
                                fi

                                # 2) External echo services (works if metadata has no public IP / non-EC2)
                                if [ -z "$IP" ]; then
                                    IP=$(curl -sf --max-time 3 https://checkip.amazonaws.com 2>/dev/null | tr -d '\\r\\n')
                                fi
                                if [ -z "$IP" ]; then
                                    IP=$(curl -sf --max-time 3 https://api.ipify.org 2>/dev/null | tr -d '\\r\\n')
                                fi

                                # 3) Last resort: primary host address (may be private)
                                if [ -z "$IP" ]; then
                                    IP=$(hostname -I 2>/dev/null | awk '{print $1}')
                                fi

                                echo "$IP"
                            ''',
                            returnStdout: true
                        ).trim()
                        echo "Detected PUBLIC_HOST_IP: ${env.PUBLIC_HOST_IP}"
                    }
                    if (!env.PUBLIC_HOST_IP?.trim()) {
                        error('Could not determine PUBLIC_HOST_IP. Set build parameter PUBLIC_HOST_IP_OVERRIDE.')
                    }
                }
            }
        }

        stage('Code-Check') {
            steps {
                echo 'Checking required project files...'
                sh '''
                    test -f Dockerfile
                    test -f index.html
                    test -f "${K8S_MANIFEST}"
                    echo "Dockerfile, index.html, and ${K8S_MANIFEST} are present"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building Docker image ${LOCAL_IMAGE} (httpd:alpine + calculator)..."
                sh '''
                    docker build -t ${LOCAL_IMAGE} .
                    docker images | grep -E "simplecasioimg|REPOSITORY" || true
                '''
            }
        }

        stage('Tag Image') {
            steps {
                echo "Tagging ${LOCAL_IMAGE} as ${DEPLOY_IMAGE} for Docker Hub / Deployment..."
                sh 'docker tag ${LOCAL_IMAGE} ${DEPLOY_IMAGE}'
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                echo "Pushing ${DEPLOY_IMAGE} so Minikube can pull the latest with imagePullPolicy: Always..."
                withCredentials([usernamePassword(
                    credentialsId: "${params.DOCKERHUB_CREDENTIALS_ID}",
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DEPLOY_IMAGE}
                        docker logout || true
                    '''
                }
            }
        }

        stage('Local Smoke (optional)') {
            when {
                expression { return params.RUN_LOCAL_CONTAINER == true }
            }
            steps {
                echo "Running local container on port ${HOST_PORT}, verify briefly, then remove..."
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d -p ${HOST_PORT}:80 --name ${CONTAINER_NAME} ${LOCAL_IMAGE}

                    echo "Waiting a few seconds for Apache to become ready..."
                    sleep 5

                    echo "Verifying container is running..."
                    docker ps --filter "name=${CONTAINER_NAME}" --filter "status=running" | grep ${CONTAINER_NAME}

                    echo "Verifying HTTP response on port ${HOST_PORT}..."
                    curl -sf --max-time 10 "http://127.0.0.1:${HOST_PORT}/" | head -c 200
                    echo ""
                    echo "Local smoke OK: http://localhost:${HOST_PORT}/"

                    echo "Removing local smoke container..."
                    docker rm -f ${CONTAINER_NAME}
                    docker ps -a --filter "name=${CONTAINER_NAME}" || true
                '''
            }
        }

        stage('Minikube Setup') {
            steps {
                echo "Ensuring Minikube is running (k8s ${MINIKUBE_K8S_VERSION})..."
                // First-time start can download ISO/k8s components and take several minutes
                timeout(time: 20, unit: 'MINUTES') {
                    sh '''
                        if ! command -v minikube >/dev/null 2>&1; then
                            echo "ERROR: minikube not found on Jenkins agent PATH"
                            exit 1
                        fi
                        if ! command -v kubectl >/dev/null 2>&1; then
                            echo "ERROR: kubectl not found on Jenkins agent PATH"
                            exit 1
                        fi

                        # Start only if not already running (first start may take a long time)
                        if ! minikube status >/dev/null 2>&1; then
                            echo "Starting Minikube (first run may download components — please wait)..."
                            minikube start \
                                --kubernetes-version=${MINIKUBE_K8S_VERSION} \
                                --cpus=${MINIKUBE_CPUS} \
                                --memory=${MINIKUBE_MEMORY} \
                                --wait=all \
                                --wait-timeout=600s
                        else
                            echo "Minikube already running"
                            minikube status || true
                        fi

                        echo "Waiting for cluster API and node Ready (poll up to ~5 minutes)..."
                        READY=0
                        i=1
                        while [ "${i}" -le 60 ]; do
                            if minikube status >/dev/null 2>&1 \
                               && kubectl get --raw=/readyz >/dev/null 2>&1 \
                               && kubectl get nodes --no-headers 2>/dev/null | grep -qi ' Ready'; then
                                READY=1
                                echo "Cluster is ready (attempt ${i})"
                                break
                            fi
                            echo "Not ready yet (attempt ${i}/60) — sleeping 5s..."
                            sleep 5
                            i=$((i + 1))
                        done

                        if [ "${READY}" != "1" ]; then
                            echo "ERROR: Minikube/Kubernetes did not become Ready in time"
                            minikube status || true
                            kubectl get nodes -o wide || true
                            exit 1
                        fi

                        # Brief settle delay before image load / kubectl apply
                        sleep 10

                        kubectl get nodes -o wide
                        kubectl cluster-info || true
                        echo "Minikube setup complete — safe to continue"
                    '''
                }
            }
        }

        stage('Load Image into Minikube') {
            steps {
                echo "Optional: load ${DEPLOY_IMAGE} into Minikube (Hub push is source of truth with Always)..."
                sh '''
                    # Not required when imagePullPolicy is Always + image was pushed,
                    # but speeds first pull / helps if Hub is briefly slow.
                    minikube image load ${DEPLOY_IMAGE} || true
                    minikube image ls | grep -i simplecasio || true
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                echo "Applying Deployment + Service (RollingUpdate keeps Service available)..."
                sh '''
                    kubectl apply -f ${K8S_MANIFEST}

                    # RollingUpdate (in YAML) + 3 replicas ≈ near zero downtime at Service/NodePort level.
                    # Public URL downtime usually comes from killing port-forward — not from this restart —
                    # if simplecasio-port-forward.service is installed with Restart=always.
                    echo "Rolling restart so pods pull the latest pushed image..."
                    kubectl rollout restart deploy/${K8S_DEPLOY}
                    kubectl rollout status deploy/${K8S_DEPLOY} --timeout=180s

                    kubectl get deploy,rs,pods,svc -l app=simplecasio_lbl
                    kubectl get endpoints ${K8S_SERVICE} || true

                    echo "Verify HTML version inside a running pod:"
                    kubectl exec deploy/${K8S_DEPLOY} -- \
                      grep -o "Simple calculator App[^<]*" /usr/local/apache2/htdocs/index.html || true
                '''
            }
        }

        stage('Expose Service URL') {
            steps {
                echo 'Ensuring durable :30060 exposure (prefer systemd; avoid ephemeral port-forward)...'
                sh '''
                    set +e
                    NODE_IP=$(minikube ip 2>/dev/null)
                    NODE_PORT=$(kubectl get svc ${K8S_SERVICE} -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null)
                    NODE_PORT=${NODE_PORT:-${BROWSER_PORT}}
                    MINIKUBE_URL="http://${NODE_IP}:${NODE_PORT}"
                    BROWSER_URL="http://${PUBLIC_HOST_IP}:${BROWSER_PORT}/"

                    echo "minikube NodePort URL (host-local only): ${MINIKUBE_URL}"
                    echo "Browser URL: ${BROWSER_URL}"

                    # Prefer systemd unit so the tunnel survives Jenkins builds (zero manual restart).
                    if command -v systemctl >/dev/null 2>&1 && \
                       systemctl list-unit-files simplecasio-port-forward.service 2>/dev/null | grep -q simplecasio-port-forward; then
                        echo "Restarting systemd unit simplecasio-port-forward.service..."
                        sudo -n systemctl restart simplecasio-port-forward.service 2>/dev/null \
                          || sudo systemctl restart simplecasio-port-forward.service 2>/dev/null \
                          || echo "WARN: could not restart systemd unit (install scripts/ + sudoers; see README)"
                        sleep 2
                        sudo -n systemctl is-active simplecasio-port-forward.service 2>/dev/null || true
                    else
                        # Fallback: only start nohup if nothing is listening yet (do NOT pkill a healthy forwarder)
                        if curl -sf --max-time 3 "http://127.0.0.1:${BROWSER_PORT}/" >/dev/null 2>&1; then
                            echo "Port ${BROWSER_PORT} already serving — leaving existing forwarder alone (no downtime)."
                        else
                            echo "No systemd unit found; starting background port-forward (may die when agent cleans up)."
                            echo "Install durable exposure once: sudo bash scripts/install-port-forward-service.sh"
                            nohup kubectl port-forward --address 0.0.0.0 svc/${K8S_SERVICE} ${BROWSER_PORT}:80 \
                                >/tmp/simplecasio-port-forward.log 2>&1 &
                            echo $! > /tmp/simplecasio-port-forward.pid
                            sleep 3
                        fi
                    fi

                    echo "${BROWSER_URL}" > app-url.txt
                    echo "${MINIKUBE_URL}" > minikube-service-url.txt

                    if curl -sf --max-time 8 "http://127.0.0.1:${BROWSER_PORT}/" >/dev/null; then
                        echo "OK: app responds on 127.0.0.1:${BROWSER_PORT}"
                    else
                        echo "WARN: localhost :${BROWSER_PORT} not ready yet"
                        cat /tmp/simplecasio-port-forward.log 2>/dev/null || true
                        sudo systemctl status --no-pager simplecasio-port-forward.service 2>/dev/null || true
                    fi

                    echo ""
                    echo "========== OPEN IN BROWSER =========="
                    echo "Browser URL (stable port): ${BROWSER_URL}"
                    echo "Cluster NodePort (EC2 only): ${MINIKUBE_URL}"
                    echo "SG: allow inbound TCP ${BROWSER_PORT}"
                    echo "====================================="
                    curl -sf --max-time 8 "http://127.0.0.1:${BROWSER_PORT}/" | head -c 200 || true
                    echo ""
                '''
                archiveArtifacts artifacts: 'app-url.txt,minikube-service-url.txt', fingerprint: true
            }
        }
    }

    post {
        success {
            script {
                def url = fileExists('app-url.txt') ? readFile('app-url.txt').trim() : '(missing app-url.txt)'
                def mk = fileExists('minikube-service-url.txt') ? readFile('minikube-service-url.txt').trim() : '(n/a)'
                echo """
============================================================
Pipeline succeeded.

minikube service --url : ${mk}
Open in browser        : ${url}

Open TCP for that port in EC2 security group (${env.PUBLIC_HOST_IP}).
============================================================
"""
            }
        }
        failure {
            echo 'Pipeline failed. Ensure Docker Desktop, minikube, and kubectl are installed and available to the Jenkins agent user.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
