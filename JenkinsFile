pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RUN_LOCAL_CONTAINER',
            defaultValue: false,
            description: 'Also run a local docker container on port 7070 (manual docker run step)'
        )
    }

    environment {
        // Local build tag (manual: docker build -t simplecasioimg:1.0 .)
        LOCAL_IMAGE    = 'simplecasioimg:1.0'
        // Tag used by Deployment + minikube image load
        DEPLOY_IMAGE   = 'dockermano1984/simplecasioimg:1.1'
        CONTAINER_NAME = 'simplecasiocntr'
        HOST_PORT      = '7070'
        K8S_DEPLOY     = 'simplecasio-deployment'
        K8S_SERVICE    = 'simplecasiopod-service'
        K8S_MANIFEST   = 'simplecasio_deployment.yaml'
        MINIKUBE_K8S_VERSION = 'v1.32.0'
        MINIKUBE_CPUS  = '1'
        MINIKUBE_MEMORY = '2000'
        // EC2 public IP — used in the final browser URL after minikube service --url
        PUBLIC_HOST_IP = '43.204.100.183'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                // Uses SCM configured on the Jenkins job (Pipeline script from SCM)
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Code-Check') {
            steps {
                echo 'Checking required project files...'
                sh '''
                    test -f Dockerfile
                    test -f index.html
                    test -f "${K8S_MANIFEST}"
                    echo "Dockerfile, index.html, and ${K8S_MANIFEST} are present"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                echo "Building Docker image ${LOCAL_IMAGE} (httpd:alpine + calculator)..."
                sh '''
                    docker build -t ${LOCAL_IMAGE} .
                    docker images | grep -E "simplecasioimg|REPOSITORY" || true
                '''
            }
        }

        stage('Tag Image') {
            steps {
                echo "Tagging ${LOCAL_IMAGE} as ${DEPLOY_IMAGE} for Minikube / Deployment..."
                sh 'docker tag ${LOCAL_IMAGE} ${DEPLOY_IMAGE}'
            }
        }

        stage('Local Smoke (optional)') {
            when {
                expression { return params.RUN_LOCAL_CONTAINER == true }
            }
            steps {
                echo "Running local container on port ${HOST_PORT}, verify briefly, then remove..."
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d -p ${HOST_PORT}:80 --name ${CONTAINER_NAME} ${LOCAL_IMAGE}

                    echo "Waiting a few seconds for Apache to become ready..."
                    sleep 5

                    echo "Verifying container is running..."
                    docker ps --filter "name=${CONTAINER_NAME}" --filter "status=running" | grep ${CONTAINER_NAME}

                    echo "Verifying HTTP response on port ${HOST_PORT}..."
                    curl -sf --max-time 10 "http://127.0.0.1:${HOST_PORT}/" | head -c 200
                    echo ""
                    echo "Local smoke OK: http://localhost:${HOST_PORT}/"

                    echo "Removing local smoke container..."
                    docker rm -f ${CONTAINER_NAME}
                    docker ps -a --filter "name=${CONTAINER_NAME}" || true
                '''
            }
        }

        stage('Minikube Setup') {
            steps {
                echo "Ensuring Minikube is running (k8s ${MINIKUBE_K8S_VERSION})..."
                // First-time start can download ISO/k8s components and take several minutes
                timeout(time: 20, unit: 'MINUTES') {
                    sh '''
                        if ! command -v minikube >/dev/null 2>&1; then
                            echo "ERROR: minikube not found on Jenkins agent PATH"
                            exit 1
                        fi
                        if ! command -v kubectl >/dev/null 2>&1; then
                            echo "ERROR: kubectl not found on Jenkins agent PATH"
                            exit 1
                        fi

                        # Start only if not already running (first start may take a long time)
                        if ! minikube status >/dev/null 2>&1; then
                            echo "Starting Minikube (first run may download components — please wait)..."
                            minikube start \
                                --kubernetes-version=${MINIKUBE_K8S_VERSION} \
                                --cpus=${MINIKUBE_CPUS} \
                                --memory=${MINIKUBE_MEMORY} \
                                --wait=all \
                                --wait-timeout=600s
                        else
                            echo "Minikube already running"
                            minikube status || true
                        fi

                        echo "Waiting for cluster API and node Ready (poll up to ~5 minutes)..."
                        READY=0
                        i=1
                        while [ "${i}" -le 60 ]; do
                            if minikube status >/dev/null 2>&1 \
                               && kubectl get --raw=/readyz >/dev/null 2>&1 \
                               && kubectl get nodes --no-headers 2>/dev/null | grep -qi ' Ready'; then
                                READY=1
                                echo "Cluster is ready (attempt ${i})"
                                break
                            fi
                            echo "Not ready yet (attempt ${i}/60) — sleeping 5s..."
                            sleep 5
                            i=$((i + 1))
                        done

                        if [ "${READY}" != "1" ]; then
                            echo "ERROR: Minikube/Kubernetes did not become Ready in time"
                            minikube status || true
                            kubectl get nodes -o wide || true
                            exit 1
                        fi

                        # Brief settle delay before image load / kubectl apply
                        sleep 10

                        kubectl get nodes -o wide
                        kubectl cluster-info || true
                        echo "Minikube setup complete — safe to continue"
                    '''
                }
            }
        }

        stage('Load Image into Minikube') {
            steps {
                echo "Loading ${DEPLOY_IMAGE} into Minikube (Docker Desktop does not share images automatically)..."
                sh '''
                    minikube image load ${DEPLOY_IMAGE}
                    minikube image ls | grep -i simplecasio || true
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                echo "Applying Deployment + Service from ${K8S_MANIFEST}..."
                sh '''
                    kubectl apply -f ${K8S_MANIFEST}

                    # apply alone restarts pods ONLY if the Pod template in the YAML changed.
                    # HTML/image rebuilds that keep the same tag (e.g. :1.1) need an explicit restart
                    # so Running pods pick up the freshly loaded image.
                    echo "Rolling restart so pods use the latest loaded image..."
                    kubectl rollout restart deploy/${K8S_DEPLOY}
                    kubectl rollout status deploy/${K8S_DEPLOY} --timeout=180s

                    kubectl get deploy,rs,pods,svc -l app=simplecasio_lbl
                    kubectl get endpoints ${K8S_SERVICE} || true
                '''
            }
        }

        stage('Expose Service URL') {
            steps {
                echo 'Getting URL from minikube service --url and publishing with EC2 public IP...'
                sh '''
                    set -e
                    set +e

                    echo "Running: minikube service ${K8S_SERVICE} --url"
                    # Capture URL (may be http://127.0.0.1:PORT or http://192.168.x.x:NODEPORT)
                    MINIKUBE_URL=$(minikube service ${K8S_SERVICE} --url 2>/tmp/minikube-service.err | head -n 1 | tr -d '\\r')
                    if [ -z "${MINIKUBE_URL}" ]; then
                        echo "minikube service --url returned empty; stderr:"
                        cat /tmp/minikube-service.err 2>/dev/null || true
                        # Fallback to NodePort on minikube ip
                        NODE_IP=$(minikube ip)
                        NODE_PORT=$(kubectl get svc ${K8S_SERVICE} -o jsonpath='{.spec.ports[0].nodePort}')
                        MINIKUBE_URL="http://${NODE_IP}:${NODE_PORT}"
                    fi

                    echo "minikube service --url => ${MINIKUBE_URL}"

                    # Extract port from URL (last :number)
                    SVC_PORT=$(echo "${MINIKUBE_URL}" | sed -n 's/.*:\\([0-9][0-9]*\\).*/\\1/p')
                    if [ -z "${SVC_PORT}" ]; then
                        echo "ERROR: could not parse port from ${MINIKUBE_URL}"
                        exit 1
                    fi
                    echo "Parsed service port: ${SVC_PORT}"

                    # minikube tunnel/URL is usually localhost or cluster-IP only.
                    # Re-expose the same PORT on 0.0.0.0 so http://PUBLIC_HOST_IP:PORT works from your browser.
                    pkill -f "port-forward.*${K8S_SERVICE}" 2>/dev/null || true
                    sleep 1
                    nohup kubectl port-forward --address 0.0.0.0 svc/${K8S_SERVICE} ${SVC_PORT}:80 \
                        >/tmp/simplecasio-port-forward.log 2>&1 &
                    echo $! > /tmp/simplecasio-port-forward.pid
                    sleep 3

                    BROWSER_URL="http://${PUBLIC_HOST_IP}:${SVC_PORT}/"
                    echo "${BROWSER_URL}" > app-url.txt
                    echo "${MINIKUBE_URL}" > minikube-service-url.txt

                    # Verify from the agent via localhost
                    if curl -sf --max-time 8 "http://127.0.0.1:${SVC_PORT}/" >/dev/null; then
                        echo "OK: app responds on 127.0.0.1:${SVC_PORT}"
                    else
                        echo "WARN: localhost check failed; port-forward log:"
                        cat /tmp/simplecasio-port-forward.log 2>/dev/null || true
                    fi

                    echo ""
                    echo "========== OPEN IN BROWSER =========="
                    echo "minikube service --url : ${MINIKUBE_URL}"
                    echo "Browser URL (EC2)      : ${BROWSER_URL}"
                    echo "Allow inbound TCP ${SVC_PORT} in the EC2 security group for ${PUBLIC_HOST_IP}"
                    echo "====================================="
                    echo ""
                    curl -sf --max-time 8 "http://127.0.0.1:${SVC_PORT}/" | head -c 200 || true
                    echo ""
                '''
                archiveArtifacts artifacts: 'app-url.txt,minikube-service-url.txt', fingerprint: true
            }
        }
    }

    post {
        success {
            script {
                def url = fileExists('app-url.txt') ? readFile('app-url.txt').trim() : '(missing app-url.txt)'
                def mk = fileExists('minikube-service-url.txt') ? readFile('minikube-service-url.txt').trim() : '(n/a)'
                echo """
============================================================
Pipeline succeeded.

minikube service --url : ${mk}
Open in browser        : ${url}

Open TCP for that port in EC2 security group (${env.PUBLIC_HOST_IP}).
============================================================
"""
            }
        }
        failure {
            echo 'Pipeline failed. Ensure Docker Desktop, minikube, and kubectl are installed and available to the Jenkins agent user.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
